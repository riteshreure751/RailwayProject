@app.post("/api/upload")
def upload():
    f = request.files["file"]
    name = secure_filename(f.filename)
    if not name.endswith((".py", ".txt", ".json")):
        return jsonify(error="Only .py, .txt, .json"), 400
    f.save(safe(name))
    return jsonify(ok=True, name=name)


run_proc = None
run_log = collections.deque(maxlen=1000)


def _pump(proc):
    for line in proc.stdout:
        run_log.append(line)
    run_log.append(f"\n[process exited with code {proc.wait()}]\n")


@app.post("/api/run")
def run_script():
    global run_proc
    name = request.json["name"]
    if not name.endswith(".py"):
        return jsonify(error="Only .py files can run"), 400
    p = safe(name)
    if run_proc and run_proc.poll() is None:
        return jsonify(error="A script is already running"), 400
    run_log.clear()
    run_log.append(f"$ python3 {name}\n")
    run_proc = subprocess.Popen(["python3", "-u", str(p)], cwd=str(BASE),
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    threading.Thread(target=_pump, args=(run_proc,), daemon=True).start()
    return jsonify(ok=True)


@app.post("/api/run/stop")
def run_stop():
    if run_proc and run_proc.poll() is None:
        run_proc.terminate()
    return jsonify(ok=True)


@app.get("/api/run/log")
def run_log_route():
    return jsonify(log="".join(run_log))


term_cwd = str(BASE)


@app.post("/api/terminal")
def terminal():
    global term_cwd
    cmd = request.json.get("cmd", "").strip()
    if not cmd:
        return jsonify(out="")
    if cmd == "cd" or cmd.startswith("cd "):
        target = (Path(term_cwd) / cmd[3:].strip()).resolve()
        if target.is_dir():
            term_cwd = str(target)
            return jsonify(out=f"cwd: {term_cwd}", cwd=term_cwd)
        return jsonify(out="No such directory", cwd=term_cwd)
    try:
        r = subprocess.run(cmd, shell=True, cwd=term_cwd, capture_output=True, text=True, timeout=60)
        out = r.stdout + r.stderr
    except subprocess.TimeoutExpired:
        out = "Timed out after 60 seconds (interactive programs are not supported)"
    return jsonify(out=out or "(no output)", cwd=term_cwd)


@app.post("/api/shutdown")
def shutdown():
    train.stop()
    subprocess.Popen(["sudo", "-n", "/usr/sbin/shutdown", "-h", "now"])
    return jsonify(ok=True, message="Shutting down")


