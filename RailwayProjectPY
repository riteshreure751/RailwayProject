  <div class="card">
    <h3>Code Editor & Runner</h3>
    <select id="files" size="5" style="width:100%" onchange="openFile(this.value)"></select>
    <div>
      <input type="file" id="upcode" accept=".py,.txt,.json">
      <button onclick="uploadCode()">Upload file</button>
    </div>
    <input id="fname" placeholder="file name e.g. test_motor.py">
    <button onclick="saveFile()">💾 Save</button>
    <button onclick="runFile()">▶ Run</button>
    <button class="grey" onclick="api('/api/run/stop',{})">Stop run</button>
    <textarea id="code" spellcheck="false"></textarea>
    <pre id="runlog"></pre>
  </div>

  <div class="card" style="grid-column:1/-1">
    <h3>Terminal</h3>
    <pre id="term" style="height:220px"></pre>
    <input id="cmd" style="width:75%" placeholder="e.g. ls, cd ~, python3 test.py"
           onkeydown="if(event.key==='Enter')runCmd()">
    <button onclick="runCmd()">Run command</button>
  </div>

</div>

<script>
let TOKEN = localStorage.getItem("tok") || prompt("Access token (from CFG token in railwayproject.py)") || "";
localStorage.setItem("tok", TOKEN);
const $ = id => document.getElementById(id);

async function handle(r) {
  if (r.status === 401) {
    TOKEN = prompt("Wrong token. Enter access token") || "";
    localStorage.setItem("tok", TOKEN);
    $("cam").src = "/video_feed?token=" + encodeURIComponent(TOKEN);
    return { error: "unauthorized" };
  }
  return r.json();
}
async function api(path, body) {
  const opt = { method: body ? "POST" : "GET", headers: { "X-Token": TOKEN } };
  if (body) { opt.headers["Content-Type"] = "application/json"; opt.body = JSON.stringify(body); }
  return handle(await fetch(path, opt));
}
async function postForm(path, fd) {
  return handle(await fetch(path, { method: "POST", headers: { "X-Token": TOKEN }, body: fd }));
}

async function startTrain() {
  const r = await api("/api/start", {});
  if (r.error || r.ok === false) alert(r.message || r.error);
}

function setBar(id, val, max) {
  $(id).style.width = val == null ? "0%" : Math.min(100, val / max * 100) + "%";
}
const show = v => (v == null ? "-" : v);

async function poll() {
  const s = await api("/api/status");
  if (s.error) return;
  $("us").textContent = show(s.us_cm);      setBar("us_bar", s.us_cm, 200);
  $("lz").textContent = show(s.lidar_cm);   setBar("lz_bar", s.lidar_cm, 200);
  $("st").textContent = show(s.lidar_strength); setBar("st_bar", s.lidar_strength, 1000);
  $("tp").textContent = show(s.lidar_temp);
  $("near").textContent = show(s.nearest);
  $("stopcm").textContent = s.stop_cm;
  $("label").textContent = s.vision.label;
  $("conf").textContent = "(" + (s.vision.confidence * 100).toFixed(0) + "%)";
  $("vmode").textContent = "[" + s.vision.mode + "]";
  $("moving").textContent = s.moving ? "RUNNING" : "STOPPED";
  $("latched").textContent = s.latched ? "YES" : "no";
  $("pwm").textContent = (s.speed * 100).toFixed(0) + "%";
  $("reason").textContent = s.reason;
  $("state").textContent = s.reason;
  $("state").style.background = s.latched ? "#c33" : s.moving ? "#2a6" : "#333";

  const log = await api("/api/run/log");
  if (log.log !== undefined) {
    $("runlog").textContent = log.log;
    $("runlog").scrollTop = $("runlog").scrollHeight;
  }
}

function setSpeed(v) { api("/api/speed", { value: v / 100 }); }

async function capture() {
  const label = $("label_in").value;
  const r = await api("/api/capture", { label });
  alert(r.error ? r.error : "Saved " + r.saved);
  loadDataset();
}
async function uploadImg() {
  const f = $("upimg").files[0];
  if (!f) return alert("Choose an image first");
  const fd = new FormData();
  fd.append("label", $("label_in").value);
  fd.append("file", f);
  const r = await postForm("/api/dataset/upload", fd);
  alert(r.error ? r.error : "Image added to dataset");
  loadDataset();
}
async function loadDataset() {
  const c = await api("/api/dataset");
  if (c.error) return;
  $("dataset").textContent = Object.keys(c).length
    ? Object.entries(c).map(([k, v]) => `${k}: ${v} images`).join("\n")
    : "No dataset yet";
}

async function loadFiles() {
  const list = await api("/api/files");
  if (list.error) return;
  $("files").innerHTML = list.map(n => `<option value="${n}">${n}</option>`).join("");
}
async function openFile(name) {
  const r = await api("/api/file?name=" + encodeURIComponent(name));
  if (r.content !== undefined) { $("code").value = r.content; $("fname").value = name; }
}
async function saveFile() {
  const name = $("fname").value.trim();
  if (!name) return alert("Enter a file name");
  const r = await api("/api/file", { name, content: $("code").value });
  if (r.error) alert(r.error); else loadFiles();
}
async function runFile() {
  const name = $("fname").value.trim();
  if (!name) return alert("Open or name a .py file first");
  await saveFile();
  const r = await api("/api/run", { name });
  if (r.error) alert(r.error);
}
async function uploadCode() {
  const f = $("upcode").files[0];
  if (!f) return alert("Choose a file first");
  const fd = new FormData();
  fd.append("file", f);
  const r = await postForm("/api/upload", fd);
  alert(r.error ? r.error : "Uploaded " + r.name);
  loadFiles();
}

async function runCmd() {
  const c = $("cmd").value;
  if (!c.trim()) return;
  $("term").textContent += "\n$ " + c + "\n";
  const r = await api("/api/terminal", { cmd: c });
  $("term").textContent += (r.out || r.error || "") + "\n";
  $("term").scrollTop = $("term").scrollHeight;
  $("cmd").value = "";
}

function shutdownPi() {
  if (confirm("Shut down the Raspberry Pi now?")) api("/api/shutdown", {});
}

$("cam").src = "/video_feed?token=" + encodeURIComponent(TOKEN);
setInterval(poll, 300);
setInterval(loadDataset, 3000);
loadDataset();
loadFiles();
</script>
</body>
</html>
"""


# ============================================================
# MAIN
# ============================================================
if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, threaded=True)
