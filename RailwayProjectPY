# ============================================================
# TRAIN SAFETY LOGIC (runs 20 times per second)
# ============================================================
class Train:
    def __init__(self):
        self.lock = threading.Lock()
        self.moving = False
        self.latched = False
        self.reason = "Idle - press Start"
        self.max_speed = CFG["medium_speed"]
        self.start_time = 0.0
        self.speed = 0.0
        self.safe_now = False
        self.data = {"us_cm": None, "lidar_cm": None, "lidar_strength": None,
                     "lidar_temp": None, "nearest": None}
        threading.Thread(target=self._loop, daemon=True).start()

    def _loop(self):
        while True:
            t = time.time()
            try:
                self._step(t)
            except Exception as e:
                motor.stop()
                with self.lock:
                    self.moving = False
                    self.latched = True
                    self.reason = f"Control error: {e}"
            time.sleep(max(0, 0.05 - (time.time() - t)))

    def _step(self, now):
        us_cm = us.read()
        strength = lidar.strength or 0
        lidar_ok = (lidar.distance_cm is not None
                    and now - lidar.last_ok < CFG["sensor_timeout_s"]
                    and strength >= CFG["lidar_min_strength"])
        lidar_cm = lidar.distance_cm if lidar_ok else None

        readings = [d for d in (us_cm, lidar_cm) if d is not None]
        nearest = min(readings) if readings else None
        sensors_ok = bool(readings)

        vision_danger = (vision.label in CFG["obstacle_labels"]
                         and vision.confidence >= CFG["vision_confidence"])
        dist_danger = nearest is not None and nearest < CFG["stop_distance_cm"]
        danger = dist_danger or vision_danger or not sensors_ok

        if dist_danger:
            why = f"Obstacle at {nearest} cm"
        elif vision_danger:
            why = f"Camera sees: {vision.label}"
        else:
            why = "Sensor fault - no valid readings"

        with self.lock:
            self.data = {"us_cm": us_cm, "lidar_cm": lidar_cm, "lidar_strength": strength,
                         "lidar_temp": lidar.temp_c, "nearest": nearest}
            self.safe_now = not danger

            if danger:
                if self.moving or self.latched:
                    self.moving = False
                    self.latched = True
                    self.reason = f"EMERGENCY STOP: {why}"
                motor.stop()
                self.speed = 0.0
            elif self.moving:
                slow = (now - self.start_time < CFG["ramp_seconds"]) or \
                       (nearest is not None and nearest < CFG["slow_zone_cm"])
                if slow:
                    self.speed = min(self.max_speed, CFG["slow_speed"])
                    self.reason = "Running - slow zone / starting"
                else:
                    self.speed = self.max_speed
                    self.reason = "Running - cruising"
                motor.forward(self.speed)
            else:
                motor.stop()
                self.speed = 0.0
                if not self.latched:
                    self.reason = "Idle - ready"

    def start(self):
        with self.lock:
            if not self.safe_now:
                return False, "Path not clear or sensors not ready - cannot start"
            self.moving = True
            self.latched = False
            self.start_time = time.time()
            self.reason = "Starting slowly"
            return True, "Started"

    def stop(self):
        with self.lock:
            self.moving = False
            self.latched = False
            self.reason = "Stopped by operator"
        motor.stop()

    def set_speed(self, v):
        with self.lock:
            self.max_speed = max(0.1, min(1.0, v))

    def snapshot(self):
        with self.lock:
            return {**self.data, "moving": self.moving, "latched": self.latched,
                    "reason": self.reason, "speed": self.speed, "max_speed": self.max_speed,
                    "stop_cm": CFG["stop_distance_cm"], "safe": self.safe_now}


