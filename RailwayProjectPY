@app.post("/api/capture")
def capture():
    label = clean_label(request.json.get("label", ""))
    if not label:
        return jsonify(error="Enter a label first (e.g. clear, obstacle, person)"), 400
    try:
        name = vision.capture(label)
    except RuntimeError as e:
        return jsonify(error=str(e)), 400
    return jsonify(ok=True, saved=f"{label}/{name}")


@app.post("/api/dataset/upload")
def dataset_upload():
    label = clean_label(request.form.get("label", ""))
    f = request.files.get("file")
    if not label or not f:
        return jsonify(error="Need a label and an image file"), 400
    ext = Path(f.filename).suffix.lower()
    if ext not in (".jpg", ".jpeg", ".png"):
        return jsonify(error="Only jpg/png images"), 400
    d = vision.dataset / label
    d.mkdir(parents=True, exist_ok=True)
    f.save(d / f"up_{int(time.time() * 1000)}{ext}")
    return jsonify(ok=True)


