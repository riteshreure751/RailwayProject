#!/usr/bin/env python3
"""
railwayproject.py - Railway track obstacle detection (single file)

ON THE RASPBERRY PI (web control panel):
    python3 railwayproject.py
    Then open http://<pi-ip>:5000 and enter the token below.

ON YOUR PC (train the model from the dataset folder copied from the Pi):
    pip install tensorflow
    python3 railwayproject.py train
    Then copy the model/ folder to the Pi, next to this file.

Wiring (BCM GPIO numbers):
    HC-SR04 TRIG -> GPIO23, ECHO -> GPIO24 (through voltage divider)
    L298N ENA+ENB -> GPIO18 (PWM speed), IN1 -> GPIO5, IN3 -> GPIO6
    L298N IN2 and IN4 -> GND (forward only)
    TF-Luna UART on /dev/serial0 (TX -> pin 10 / GPIO15, RX -> pin 8 / GPIO14)

SAFETY: this is a prototype, not a certified railway signalling system.
Test with the wheels lifted. Add a hardware emergency-stop switch that cuts motor power.
The web terminal gives full shell access, so change the token and do not expose port 5000 to the internet.
"""
import sys
from pathlib import Path

BASE = Path(__file__).resolve().parent

# ============================================================
# CONFIGURATION (edit here)
# ============================================================
CFG = {
    "token": "change-me-1234",          # web page access token - CHANGE THIS
    "stop_distance_cm": 80,             # emergency stop when obstacle is closer than this
    "slow_zone_cm": 200,                # creep speed when obstacle is inside this distance
    "slow_speed": 0.35,                 # 0.0 - 1.0
    "medium_speed": 0.65,               # cruising speed (also the default max speed)
    "ramp_seconds": 3,                  # slow start time after pressing Start
    "lidar_min_strength": 100,          # ignore TF-Luna readings weaker than this
    "sensor_timeout_s": 0.5,            # treat a sensor as faulty if no data for this long
    "obstacle_labels": ["obstacle", "person", "animal", "stone", "vehicle"],
    "vision_confidence": 0.7,
}


# ============================================================
# TRAINING (runs on PC only: python3 railwayproject.py train)
# ============================================================
def train_model():
    import tensorflow as tf

    data_dir = str(BASE / "dataset")
    size, batch = (224, 224), 16

    train_ds, val_ds = tf.keras.utils.image_dataset_from_directory(
        data_dir, image_size=size, batch_size=batch,
        validation_split=0.2, subset="both", seed=42)
    labels = train_ds.class_names
    autotune = tf.data.AUTOTUNE

    aug = tf.keras.Sequential([
        tf.keras.layers.RandomFlip("horizontal"),
        tf.keras.layers.RandomRotation(0.05),
        tf.keras.layers.RandomContrast(0.2),
    ])
    base = tf.keras.applications.MobileNetV2(input_shape=size + (3,), include_top=False, weights="imagenet")
    base.trainable = False

    inputs = tf.keras.Input(shape=size + (3,))
    x = aug(inputs)
    x = tf.keras.layers.Rescaling(1 / 127.5, offset=-1)(x)   # model takes raw 0-255 pixels
    x = base(x, training=False)
    x = tf.keras.layers.GlobalAveragePooling2D()(x)
    x = tf.keras.layers.Dropout(0.2)(x)
    outputs = tf.keras.layers.Dense(len(labels), activation="softmax")(x)
    model = tf.keras.Model(inputs, outputs)
    model.compile(optimizer="adam", loss="sparse_categorical_crossentropy", metrics=["accuracy"])
    model.fit(train_ds.prefetch(autotune), validation_data=val_ds.prefetch(autotune), epochs=8)

    (BASE / "model").mkdir(exist_ok=True)
    tflite_bytes = tf.lite.TFLiteConverter.from_keras_model(model).convert()
    (BASE / "model" / "model.tflite").write_bytes(tflite_bytes)
    (BASE / "model" / "labels.txt").write_text("\n".join(labels))
    print("Saved model/model.tflite and model/labels.txt. Labels:", labels)


if __name__ == "__main__" and len(sys.argv) > 1 and sys.argv[1] == "train":
    train_model()
    sys.exit(0)


