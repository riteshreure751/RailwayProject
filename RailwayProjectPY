# ============================================================
# SENSORS
# ============================================================
class HCSR04:
    """HC-SR04 ultrasonic sensor. ECHO must go through the voltage divider."""

    def __init__(self, trig, echo, max_m=2.0):
        self.max_m = max_m
        self.s = DistanceSensor(echo=echo, trigger=trig, max_distance=max_m, queue_len=3)
        self.last_ok = 0

    def read(self):
        """Return distance in cm, or None if there is no echo."""
        m = self.s.distance
        if m is None or m >= self.max_m * 0.98:
            return None
        self.last_ok = time.time()
        return round(m * 100, 1)


class TFLuna(threading.Thread):
    """TF-Luna LiDAR over UART (9-byte frames at 115200 baud)."""

    def __init__(self, port="/dev/serial0", baud=115200):
        super().__init__(daemon=True)
        self.ser = serial.Serial(port, baud, timeout=0.1)
        self.distance_cm = None
        self.strength = None
        self.temp_c = None
        self.last_ok = 0

    def run(self):
        buf = bytearray()
        while True:
            data = self.ser.read(64)
            if not data:
                continue
            buf.extend(data)
            if len(buf) > 256:
                del buf[:-9]
            while len(buf) >= 9:
                if buf[0] == 0x59 and buf[1] == 0x59:
                    frame = buf[:9]
                    if sum(frame[:8]) & 0xFF == frame[8]:
                        self.distance_cm = frame[2] | (frame[3] << 8)
                        self.strength = frame[4] | (frame[5] << 8)
                        self.temp_c = round((frame[6] | (frame[7] << 8)) / 8 - 256, 1)
                        self.last_ok = time.time()
                        del buf[:9]
                        continue
                del buf[0]


# ============================================================
# MOTOR (L298N)
# ============================================================
class Motor:
    """ENA+ENB on GPIO18 (speed), IN1 on GPIO5, IN3 on GPIO6. IN2/IN4 tied to GND."""

    def __init__(self):
        self.ena = PWMOutputDevice(18, frequency=1000)
        self.in1 = DigitalOutputDevice(5)
        self.in3 = DigitalOutputDevice(6)
        self.stop()

    def forward(self, speed):
        speed = max(0.0, min(1.0, speed))
        self.in1.on()
        self.in3.on()
        self.ena.value = speed

    def stop(self):
        self.ena.value = 0
        self.in1.off()
        self.in3.off()

    @property
    def pwm(self):
        return self.ena.value


# ============================================================
# CAMERA AND VISION
# ============================================================
class Camera(threading.Thread):
    """Continuously grabs frames from the Pi Camera (BGR, like OpenCV)."""

    def __init__(self, size=(640, 480)):
        super().__init__(daemon=True)
        self.picam = Picamera2()
        self.picam.configure(self.picam.create_video_configuration(main={"size": size, "format": "RGB888"}))
        self.picam.start()
        self._frame = None
        self._lock = threading.Lock()

    def run(self):
        while True:
            frame = self.picam.capture_array()
            with self._lock:
                self._frame = frame

    def get(self):
        with self._lock:
            return None if self._frame is None else self._frame.copy()


def load_model(path):
    if not path.exists():
        return None
    try:
        from tflite_runtime.interpreter import Interpreter
    except ImportError:
        try:
            from ai_edge_litert.interpreter import Interpreter
        except ImportError:
            from tensorflow.lite import Interpreter
    interp = Interpreter(model_path=str(path))
    interp.allocate_tensors()
    return interp


class Vision(threading.Thread):
    """
    Detects what is on the track in front of the train.
    - If model/model.tflite exists (trained from your dataset), it classifies the frame.
    - Otherwise it uses motion detection (MOG2) to flag a large new object as "obstacle".
    """

    def __init__(self, cam):
        super().__init__(daemon=True)
        self.cam = cam
        self.dataset = BASE / "dataset"
        self.dataset.mkdir(exist_ok=True)
        self.interp = load_model(BASE / "model" / "model.tflite")
        label_file = BASE / "model" / "labels.txt"
        self.labels = label_file.read_text().splitlines() if self.interp else []
        self.mode = "tflite" if self.interp else "motion"
        self.bg = cv2.createBackgroundSubtractorMOG2(history=300, varThreshold=40, detectShadows=False)
        self.seen = 0
        self.label = "clear"
        self.confidence = 0.0

    def roi(self, frame):
        """Only look at the track area in front of the train (lower-middle of the image)."""
        h, w = frame.shape[:2]
        return frame[int(h * 0.35):, int(w * 0.2):int(w * 0.8)]

    def classify(self, roi):
        if self.interp:
            inp = self.interp.get_input_details()[0]
            _, h, w, _ = inp["shape"]
            rgb = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)
            x = cv2.resize(rgb, (w, h)).astype(np.float32)[None]
            self.interp.set_tensor(inp["index"], x)
            self.interp.invoke()
            out = self.interp.get_tensor(self.interp.get_output_details()[0]["index"])[0]
            i = int(np.argmax(out))
            return self.labels[i], float(out[i])

        # Motion fallback
        self.seen += 1
        fg = self.bg.apply(roi)
        if self.seen < 60:  # learn the empty track first
            return "clear", 0.0
        ratio = np.count_nonzero(fg) / fg.size
        if ratio > 0.15:
            return "obstacle", 1.0
        return "clear", 0.0

    def run(self):
        while True:
            try:
                frame = self.cam.get()
                if frame is not None:
                    self.label, self.confidence = self.classify(self.roi(frame))
            except Exception as e:
                print("Vision error:", e)
            time.sleep(0.2)

    def capture(self, label):
        frame = self.cam.get()
        if frame is None:
            raise RuntimeError("No camera frame yet")
        d = self.dataset / label
        d.mkdir(parents=True, exist_ok=True)
        name = f"{int(time.time() * 1000)}.jpg"
        cv2.imwrite(str(d / name), frame)
        return name

    def counts(self):
        return {p.name: len(list(p.glob("*.jpg"))) for p in sorted(self.dataset.iterdir()) if p.is_dir()}


