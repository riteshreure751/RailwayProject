sudo tee /etc/systemd/system/railway.service > /dev/null << 'EOF'
[Unit]
Description=Railway Dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 /home/pi/railwayproject2.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
