@app.post('/api/dataset/labels')
def save_labels():
    body=request.json or {}; name=Path(body.get('image','')).name; boxes=body.get('boxes',[])
    image=DATA/'images'/name
    if image.suffix.lower() not in ('.jpg','.jpeg','.png') or not image.is_file():return jsonify(error='Image not found'),404
    classes=[]; normalized=[]
    try:
        for b in boxes:
            cls=str(b['class']).strip()
            vals=[float(b[k]) for k in ('x','y','w','h')]
            if not cls or any(v<0 or v>1 for v in vals) or vals[2]<=0 or vals[3]<=0:raise ValueError('Invalid class or box coordinates')
            if cls not in classes:classes.append(cls)
            normalized.append((cls,*vals))
    except (KeyError,TypeError,ValueError) as e:return jsonify(error=str(e)),400
    class_file=DATA/'classes.txt'; existing=class_file.read_text().splitlines() if class_file.exists() else []
    all_classes=existing[:]
    for c in classes:
        if c not in all_classes:all_classes.append(c)
    class_file.write_text('\n'.join(all_classes)+'\n')
    lines=[f"{all_classes.index(c)} {x:.6f} {y:.6f} {w:.6f} {h:.6f}" for c,x,y,w,h in normalized]
    (DATA/'labels'/(image.stem+'.txt')).write_text('\n'.join(lines)+('\n' if lines else ''))
    return jsonify(ok=True,boxes=len(lines),classes=all_classes)
