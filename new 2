@app.post('/api/capture')
def capture_image():
    if camera is None:return jsonify(error='No live camera is connected. Start in hardware mode and check the Pi Camera.'),503
    try:
        from PIL import Image
        with camera_lock: frame=camera.capture_array()
        label=re.sub(r'[^a-zA-Z0-9_-]+','_',str((request.json or {}).get('class','')).strip()).strip('_').lower()
        if not label:return jsonify(error='Enter an object name (use clear for a clear track)'),400
        folder=DATA/'classes'/label;folder.mkdir(parents=True,exist_ok=True)
        stamp=time.strftime('%Y%m%d_%H%M%S');path=folder/f'{label}_{stamp}.jpg'
        Image.fromarray(frame).save(path,quality=92)
        return jsonify(ok=True,name=path.name,location=str(path.relative_to(ROOT)),class_name=label)
    except Exception as e:return jsonify(error=f'Image capture failed: {e}'),500
