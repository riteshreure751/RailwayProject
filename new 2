@app.post('/api/upload')
def upload():
    f=request.files.get('file')
    if not f or not f.filename:return jsonify(error='Choose a file'),400
    name=Path(f.filename).name
    if not re.fullmatch(r'[\w .()-]{1,100}\.(py|jpg|jpeg|png)',name,re.I):return jsonify(error='Allowed: Python files and images'),400
    dest=DATA/'images' if Path(name).suffix.lower() in ('.jpg','.jpeg','.png') else UPLOADS
    f.save(dest/name);return jsonify(ok=True,name=name,location=str(dest.relative_to(ROOT)))
