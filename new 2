@app.get('/api/tree')
def project_tree():
    rel=(request.args.get('path','') or '').strip('/\\')
    target=(ROOT/rel).resolve()
    if target!=ROOT and ROOT not in target.parents:return jsonify(error='Path outside project'),400
    if not target.is_dir():return jsonify(error='Folder not found'),404
    items=[]
    for p in sorted(target.iterdir(),key=lambda x:(not x.is_dir(),x.name.lower())):
        items.append({'name':p.name,'directory':p.is_dir(),'path':str(p.relative_to(ROOT)),'size':p.stat().st_size if p.is_file() else None})
    return jsonify(root=str(ROOT),current=str(target.relative_to(ROOT)) if target!=ROOT else '.',items=items)
@app.get('/video')
def video():
    def frames():
        while True:
            frame=None
            if camera:
                try:
                    import cv2
                    with camera_lock: captured=camera.capture_array()
                    image=cv2.cvtColor(captured,cv2.COLOR_RGB2BGR);ok,b=cv2.imencode('.jpg',image)
                    if ok:frame=b.tobytes()
                except Exception:pass
            elif SIMULATE:
                import cv2,numpy as np
                image=np.zeros((360,640,3),dtype=np.uint8);image[:]=(25,30,40)
                cv2.putText(image,'CAMERA SIMULATION - NO LIVE IMAGE',(55,180),cv2.FONT_HERSHEY_SIMPLEX,.8,(180,195,215),2)
                _,b=cv2.imencode('.jpg',image);frame=b.tobytes()
            if frame:yield b'--frame\r\nContent-Type: image/jpeg\r\n\r\n'+frame+b'\r\n'
            time.sleep(.08)
    return Response(frames(),mimetype='multipart/x-mixed-replace; boundary=frame')
@app.post('/api/terminal')
def terminal():
    raw=(request.json or {}).get('command','').strip()
    try:args=shlex.split(raw,posix=os.name!='nt')
    except ValueError as e:return jsonify(error=str(e)),400
    if not args:return jsonify(output='')
    if args[0] not in ('python','python3','pip','pip3'):return jsonify(error='Supported: python <uploaded.py>, pip install <package>'),400
    if args[0].startswith('python'):
        if len(args)<2 or not args[1].endswith('.py') or any(x in args for x in ('-c','-m')):return jsonify(error='Run an uploaded .py file by name'),400
        path=(UPLOADS/Path(args[1]).name).resolve()
        if path.parent!=UPLOADS.resolve() or not path.exists():return jsonify(error='Python file must be uploaded first'),400
        args[1]=str(path)
    elif len(args)<3 or args[1]!='install':return jsonify(error='Only pip install <package> is supported'),400
    try:
        r=subprocess.run(args,cwd=ROOT,capture_output=True,text=True,timeout=20,shell=False)
        return jsonify(output=(r.stdout+r.stderr)[-8000:],code=r.returncode)
    except subprocess.TimeoutExpired:return jsonify(error='Command exceeded 20 seconds'),408
@app.post('/api/shutdown')
def shutdown():
    token=os.getenv('RAILWAY_SHUTDOWN_TOKEN','')
    if not token or (request.json or {}).get('token')!=token:return jsonify(error='Shutdown token not configured or incorrect'),403
    if motors:motors.value=0
    subprocess.Popen(['sudo','-n','shutdown','-h','now']);return jsonify(ok=True)

