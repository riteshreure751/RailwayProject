"""Raspberry Pi 5 inputs: TF-Luna UART on GPIO14/15 and HC-SR04 on GPIO23/24."""
import time

class SensorSuite:
    def __init__(self):
        # TF-Luna 9-byte UART frame at the Pi's primary UART (physical 8/10).
        import serial
        from gpiozero import DistanceSensor
        self.uart=serial.Serial('/dev/serial0',115200,timeout=.04)
        self.ultra=DistanceSensor(echo=24,trigger=23,max_distance=4,threshold_distance=.6)
        self.strength=0; self._lidar=None
    def get_distance(self):
        # Bound the read time; discard bytes until a valid frame/checksum is found.
        end=time.monotonic()+.025
        while time.monotonic()<end:
            b=self.uart.read(1)
            if b!=b'Y':continue
            rest=self.uart.read(8)
            if len(rest)!=8 or rest[0]!=0x59:continue
            packet=b+rest
            if sum(packet[:8])&255 != packet[8]:continue
            cm=packet[2]+(packet[3]<<8); self.strength=packet[4]+(packet[5]<<8)
            self._lidar=float(cm) if cm>0 else None
            return self._lidar
        return self._lidar
    def get_ultrasonic(self):
        try:return round(self.ultra.distance*100,1)
        except Exception:return None

"""Small OpenCV HOG + nearest-neighbor image classifier; no YOLO or cloud service."""
from pathlib import Path
import cv2, numpy as np

def feature(image):
    gray=cv2.cvtColor(image,cv2.COLOR_RGB2GRAY) if image.ndim==3 else image
    gray=cv2.resize(gray,(96,96),interpolation=cv2.INTER_AREA)
    hog=cv2.HOGDescriptor((96,96),(24,24),(12,12),(12,12),9)
    vector=hog.compute(gray).reshape(-1).astype(np.float32)
    return vector/(np.linalg.norm(vector)+1e-8)

class ImageClassifier:
    def __init__(self,features,labels,classes):self.features=features;self.labels=labels;self.classes=classes;self.samples=len(labels)
    @classmethod
    def train(cls,root,savepath):
        feats=[]; labs=[]; names=sorted(p.name for p in Path(root).iterdir() if p.is_dir())
        if len(names)<2 or 'clear' not in names:raise ValueError('Create at least two class folders, including clear, and capture examples in each.')
        for idx,name in enumerate(names):
            images=list((Path(root)/name).glob('*.jpg'))+list((Path(root)/name).glob('*.png'))
            if len(images)<3:raise ValueError(f"Add at least 3 labeled images to data/classes/{name}/")
            for path in images:
                im=cv2.imread(str(path))
                if im is not None:feats.append(feature(cv2.cvtColor(im,cv2.COLOR_BGR2RGB)));labs.append(idx)
        if len(set(labs))<2:raise ValueError('Need readable images in at least two classes')
        model=cls(np.asarray(feats,dtype=np.float32),np.asarray(labs),names)
        np.savez_compressed(savepath,features=model.features,labels=model.labels,classes=np.array(names));return model
    @classmethod
    def load(cls,path):
        d=np.load(path);return cls(d['features'],d['labels'],d['classes'].tolist())
    def predict(self,image):
        f=feature(image);dist=np.linalg.norm(self.features-f,axis=1);i=int(np.argmin(dist))
        # Distance is a similarity heuristic, not a calibrated probability.
        confidence=float(max(0,min(1,1-float(dist[i]))))
        return self.classes[int(self.labels[i])],confidence


def set_speed(n):
    with lock:
        state['speed']=max(0,min(100,int(n))); state['mode']='slow' if state['speed']<=35 else 'medium' if state['speed']<=70 else 'fast'
        v=state['speed']/100 if state['running'] and not state['obstacle'] and not state['estop'] else 0
    if motors: motors.value=v

def trip(reason,obj='Obstacle',confidence=0):
    with lock: state.update(running=False,obstacle=True,object=obj,confidence=round(float(confidence),1),last_event=reason)
    stop_event.set()
    if motors: motors.value=0

def start_train():
    with lock:
        if state['estop'] or state['obstacle']: return False
        state.update(running=True,obstacle=False,object='Clear',confidence=0,last_event='Train started'); stop_event.clear()
    set_speed(state['speed'])
    # Controlled initial crawl, then medium speed if the train remains clear.
    threading.Thread(target=_ramp_to_medium,daemon=True).start()
    return True

def _ramp_to_medium():
    time.sleep(5)
    with lock:
        if state['running'] and not state['obstacle'] and not state['estop'] and state['speed']==25:
            state['speed']=50; state['mode']='medium'; value=.5
        else:value=None
    if value is not None and motors:motors.value=value

def sensor_loop():
    while True:
        try:
            if SIMULATE:
                with lock: state.update(lidar_cm=250.0,ultrasonic_cm=248.0,lidar_strength=900)
                time.sleep(.15); continue
            lidar=sensors.get_distance() if sensors else None; ultra=sensors.get_ultrasonic() if sensors else None
            with lock: state.update(lidar_cm=lidar,ultrasonic_cm=ultra,lidar_strength=getattr(sensors,'strength',0))
            close=[x for x in (lidar,ultra) if x is not None and 0<x<=STOP_CM]
            if close: trip(f'Range threshold reached ({min(close):.0f} cm)','Object in track',100)
            elif classifier and camera:
                with camera_lock: frame=camera.capture_array()
                name,confidence=classifier.predict(frame)
                with lock: state.update(object=name,confidence=round(confidence*100,1))
                if name.lower()!='clear' and confidence>=.55:trip(f'Camera recognized {name}',name,confidence*100)
            time.sleep(.04)
        except Exception as e:
            trip('Sensor fault: motor disabled','Sensor fault'); time.sleep(.5)

def init_hardware():
    global motors,sensors,camera
    if SIMULATE:return
    from gpiozero import PWMOutputDevice,DigitalOutputDevice
    motors=PWMOutputDevice(18,frequency=1000,initial_value=0)
    # GPIO5 -> IN1, GPIO6 -> IN3; IN2/IN4 must be held LOW at the driver.
    motors.direction_pins=(DigitalOutputDevice(5,initial_value=True),DigitalOutputDevice(6,initial_value=True))
    sensors=SensorSuite()
    try:
        from picamera2 import Picamera2
        camera=Picamera2(); camera.configure(camera.create_video_configuration(main={'size':(640,480),'format':'RGB888'})); camera.start()
    except Exception as e: print('Camera unavailable:',e)

