#!/usr/bin/env python3
"""Railway obstacle detection: Pi 5 + TF-Luna + HC-SR04 + camera + L298N.
Run:  ./venv/bin/python server.py      (SIMULATE=1 to test without hardware)"""
import os, sys, time, json, threading, subprocess, pty, signal, secrets, re, random
from pathlib import Path
import numpy as np, cv2
from flask import Flask, Response, request, jsonify, session, redirect
from flask_sock import Sock

SIM = os.environ.get("SIMULATE") == "1"
if not SIM: os.environ.setdefault("GPIOZERO_PIN_FACTORY", "lgpio")
BASE = Path(__file__).resolve().parent
CLS = BASE / "data" / "classes"; CLS.mkdir(parents=True, exist_ok=True)
(BASE / "code").mkdir(exist_ok=True)
MODEL = BASE / "classifier.npz"
SETF = BASE / "settings.json"
PIN = dict(ENA=18, IN1=5, IN3=6, TRIG=23, ECHO=24)
LIDAR_PORT = "/dev/serial0"
CFG = dict(stop_cm=60, slow_band_cm=80, cruise=50, slow=25, ramp_delay=5,
           margin_per_pct=0.3, conf=0.6, use_camera=0, stop_on_disconnect=1)
if SETF.exists(): CFG.update(json.loads(SETF.read_text()))
SIMD = {"d": 250.0}
def log(m): print(time.strftime("%H:%M:%S"), m, flush=True)

# ---------------- sensors ----------------
class Lidar(threading.Thread):
    def __init__(s): super().__init__(daemon=True); s.d=s.st=s.seq=0; s.t=0; s.valid=False; s.err=None; s.temp=0
    def run(s):
        if SIM:
            while True:
                s.d=SIMD["d"]+random.uniform(-1,1); s.st=900; s.valid=True; s.t=time.time(); s.seq+=1; time.sleep(.01)
        try:
            import serial; ser = serial.Serial(LIDAR_PORT, 115200, timeout=.05)
        except Exception as e: s.err=str(e); return
        buf = b""
        while True:
            try: buf += ser.read(max(1, ser.in_waiting))
            except Exception as e: s.err=str(e); return
            while len(buf) >= 9:
                f = buf[:9]
                if f[0]==0x59 and f[1]==0x59 and sum(f[:8]) & 255 == f[8]:
                    d=f[2]|f[3]<<8; st=f[4]|f[5]<<8
                    s.valid = 100<=st<65535 and 0<d<=800
                    s.d, s.st, s.temp, s.t = d, st, (f[6]|f[7]<<8)/8-256, time.time(); s.seq+=1
                    buf = buf[9:]
                else: buf = buf[1:]

class Ultra(threading.Thread):
    def __init__(s): super().__init__(daemon=True); s.d=s.seq=0; s.t=0; s.valid=False; s.err=None; s.st=0
    def run(s):
        if SIM:
            while True:
                s.d=SIMD["d"]+random.uniform(-1,1); s.valid=True; s.t=time.time(); s.seq+=1; time.sleep(.05)
        try:
            from gpiozero import DistanceSensor
            ds = DistanceSensor(echo=PIN["ECHO"], trigger=PIN["TRIG"], max_distance=4, queue_len=3)
        except Exception as e: s.err=str(e); return
        while True:
            d = ds.distance*100; s.valid = 2<=d<399
            s.d, s.t = d, time.time(); s.seq+=1; time.sleep(.04)

class Camera(threading.Thread):
    def __init__(s):
        super().__init__(daemon=True); s.frame=None; s.jpg=s.nojpg("STARTING CAMERA"); s.t=0; s.err=None; s.fps=0
        s.cond=threading.Condition()
    @staticmethod
    def nojpg(msg):
        im=np.zeros((480,640,3),np.uint8); cv2.putText(im,msg,(40,240),0,.9,(120,170,255),2)
        return cv2.imencode(".jpg",im)[1].tobytes()
    def push(s, img):
        ok, j = cv2.imencode(".jpg", img, [cv2.IMWRITE_JPEG_QUALITY, 70])
        with s.cond: s.frame, s.jpg, s.t = img, j.tobytes(), time.time(); s.cond.notify_all()
    def run(s):
        n, t0 = 0, time.time()
        def tick():
            nonlocal n, t0
            n+=1
            if time.time()-t0>=1: s.fps=n/(time.time()-t0); n=0; t0=time.time()
        if SIM:
            while True:
                im=np.full((480,640,3),30,np.uint8); cv2.putText(im,"SIMULATED CAMERA",(150,240),0,1,(120,255,170),2)
                s.push(im); tick(); time.sleep(.1)
        try:
            from picamera2 import Picamera2
            cam = Picamera2(); cam.configure(cam.create_video_configuration(main={"size":(640,480),"format":"RGB888"})); cam.start()
            grab = cam.capture_array
        except Exception as e:
            log(f"picamera2 unavailable ({e}); trying USB/OpenCV camera")
            cap = cv2.VideoCapture(0)
            if not cap.isOpened(): s.err="No camera found (check ribbon cable / camera enabled)"; s.jpg=s.nojpg("NO CAMERA"); return
            grab = lambda: cap.read()[1]
        while True:
            try:
                img = grab()
                if img is None: time.sleep(.05); continue
                s.push(img[:, :, :3]); tick()
            except Exception as e: s.err=str(e); time.sleep(.5)

# ---------------- classifier (kNN on HOG + colour; trains in seconds on the Pi) ----------------
HOG = cv2.HOGDescriptor((64,64),(16,16),(8,8),(8,8),9)
def feat(img):
    h = HOG.compute(cv2.cvtColor(cv2.resize(img,(64,64)),cv2.COLOR_BGR2GRAY)).ravel()
    c = cv2.calcHist([cv2.cvtColor(cv2.resize(img,(32,32)),cv2.COLOR_BGR2HSV)],[0,1,2],None,[8,4,4],[0,180,0,256,0,256]).ravel()
    v = np.concatenate([h/(np.linalg.norm(h)+1e-6), c/(np.linalg.norm(c)+1e-6)])
    return (v/np.linalg.norm(v)).astype(np.float32)
M = {"X":None,"y":None,"names":[]}
def load_model():
    if MODEL.exists():
        z=np.load(MODEL, allow_pickle=False); M.update(X=z["X"], y=z["y"], names=list(z["names"]))
def train():
    X, y, names = [], [], sorted(p.name for p in CLS.iterdir() if p.is_dir())
    if len(names) < 2: return False, "Need at least 2 classes (e.g. clear + person)."
    for i, n in enumerate(names):
        for f in CLS.joinpath(n).glob("*"):
            im = cv2.imread(str(f))
            if im is None: continue
            for a in (im, cv2.flip(im,1), cv2.convertScaleAbs(im,alpha=.8,beta=-10), cv2.convertScaleAbs(im,alpha=1.2,beta=15)):
                X.append(feat(a)); y.append(i)
    if len(set(y)) < 2: return False, "Each class needs images."
    np.savez(MODEL, X=np.array(X), y=np.array(y), names=np.array(names)); load_model()
    return True, f"Trained on {len(X)//4} images in {len(names)} classes."
def predict(img):
    if M["X"] is None: return None, 0.0, {}
    s = M["X"] @ feat(img); idx = np.argsort(-s)[:5]
    if s[idx[0]] < .5: return "unknown", 0.0, {}
    v = {}
    for i in idx: v[M["names"][M["y"][i]]] = v.get(M["names"][M["y"][i]],0) + max(float(s[i]),0)
    tot = sum(v.values()); v = {k: round(x/tot,2) for k,x in v.items()}
    lab = max(v, key=v.get); return lab, v[lab], v

class Detector(threading.Thread):
    def __init__(s): super().__init__(daemon=True); s.label=None; s.conf=0; s.scores={}; s.obstacle=False; s.seq=0; s.t=0
    def run(s):
        last = 0
        while True:
            time.sleep(.02)
            if cam.t == last or cam.frame is None or M["X"] is None: continue
            last = cam.t
            l, c, sc = predict(cam.frame)
            s.label, s.conf, s.scores = l, c, sc
            s.obstacle = l not in (None,"unknown") and not l.lower().startswith("clear") and c >= CFG["conf"]
            s.t, s.seq = last, s.seq+1

# ---------------- motor ----------------
class Motor:
    def __init__(s):
        s.err=None; s.pwm=None
        if SIM: return
        try:
            from gpiozero import PWMOutputDevice, OutputDevice
            s.pwm=PWMOutputDevice(PIN["ENA"],frequency=1000); s.in1=OutputDevice(PIN["IN1"]); s.in3=OutputDevice(PIN["IN3"])
        except Exception as e: s.err=str(e)
    def run(s,pct):
        if s.pwm: s.in1.on(); s.in3.on(); s.pwm.value=max(0,min(100,pct))/100
    def brake(s):   # IN1=IN3=LOW with EN high = fast motor stop on L298N
        if s.pwm: s.in1.off(); s.in3.off(); s.pwm.value=1
    def off(s):
        if s.pwm: s.pwm.value=0; s.in1.off(); s.in3.off()

class Controller(threading.Thread):
    def __init__(s):
        super().__init__(daemon=True); s.running=False; s.latched=False; s.reason="Ready"; s.cur=0.0
        s.t0=0; s.clear_since=0; s.hits=dict(l=0,u=0,c=0); s.seq=dict(l=0,u=0,c=0); s.trig=dict(l=0,u=0,c=0)
        s.react=None; s.zone="clear"; s.hb=time.time(); s.clients=0; s.lock=threading.Lock()
    def eff(s): return CFG["stop_cm"] + CFG["margin_per_pct"]*s.cur
    def check(s):
        now, e, near = time.time(), s.eff(), 999
        for k, sen, nm, lim, n in (("l",lid,"Lidar",.3,3),("u",ult,"Ultrasonic",.6,3)):
            if sen.err or now-sen.t > lim: return f"{nm} not responding (fail-safe)", 0, near
            if sen.seq != s.seq[k]:
                s.seq[k]=sen.seq; s.trig[k]=sen.t
                s.hits[k] = s.hits[k]+1 if (sen.valid and sen.d<=e) else 0
            if sen.valid: near=min(near,sen.d)
            if s.hits[k]>=n: return f"{nm}: obstacle at {sen.d:.0f} cm", s.trig[k], near
        if CFG["use_camera"] and M["X"] is not None:
            if now-det.t > 1.5: return "Camera not responding (fail-safe)", 0, near
            if det.seq != s.seq["c"]:
                s.seq["c"]=det.seq; s.trig["c"]=det.t; s.hits["c"] = s.hits["c"]+1 if det.obstacle else 0
            if s.hits["c"]>=2: return f"Camera sees: {det.label} ({det.conf:.0%})", s.trig["c"], near
        return None, 0, near
    def estop(s, why, t_trig=0):
        with s.lock:
            motor.brake(); s.react = round((time.time()-t_trig)*1000) if t_trig else None
            s.running=False; s.latched=True; s.cur=0; s.reason=why; log(f"STOP: {why} reaction={s.react}ms")
            threading.Timer(.5, lambda: None if s.running else motor.off()).start()
    def start(s):
        if motor.err: return False, "Motor driver error: "+motor.err
        if s.latched: return False, "Obstacle latch is set - clear the track and press Reset."
        why, _, near = s.check()
        if why: return False, why
        if near <= s.eff()+CFG["slow_band_cm"]*.0 + 5: return False, f"Obstacle already within {near:.0f} cm"
        s.hits=dict(l=0,u=0,c=0); s.running=True; s.t0=s.clear_since=time.time(); s.cur=0; s.reason="Running"; s.react=None; return True, "Started"
    def stop(s):
        with s.lock: s.running=False; s.cur=0; motor.brake(); s.reason="Stopped by operator"; threading.Timer(.4, lambda: None if s.running else motor.off()).start()
    def reset(s):
        why, _, near = s.check()
        if why: return False, why
        if near <= s.eff()+5: return False, f"Track not clear ({near:.0f} cm)"
        s.latched=False; s.reason="Ready"; return True, "Reset"
    def run(s):
        dt=.01
        while True:
            time.sleep(dt)
            if not s.running: continue
            why, tt, near = s.check()
            if not why and CFG["stop_on_disconnect"] and time.time()-s.hb > 3: why, tt = "Dashboard disconnected", 0
            if why: s.estop(why, tt); continue
            slow = near <= s.eff()+CFG["slow_band_cm"]
            if slow and s.zone=="clear": s.clear_since=time.time()
            s.zone = "slow" if slow else "clear"
            cruise = max(CFG["cruise"], CFG["slow"])
            target = CFG["slow"] if (slow or time.time()-s.clear_since < CFG["ramp_delay"]) else cruise
            s.cur = min(target, s.cur+20*dt) if target > s.cur else max(target, s.cur-100*dt)
            s.cur = max(s.cur, CFG["slow"]) if target >= CFG["slow"] else s.cur
            motor.run(s.cur)

def snap():
    now=time.time(); sen=lambda x:dict(d=round(x.d,1),st=x.st,ok=not x.err and now-x.t<1,valid=x.valid,err=x.err)
    try: cpu=int(open("/sys/class/thermal/thermal_zone0/temp").read())/1000
    except Exception: cpu=None
    return dict(sim=SIM, lidar=dict(sen(lid),temp=round(lid.temp,1)), ultra=sen(ult),
        cam=dict(ok=not cam.err and now-cam.t<2, err=cam.err, fps=round(cam.fps,1), trained=M["X"] is not None, label=det.label, conf=round(det.conf,2), scores=det.scores, obstacle=det.obstacle),
        motor=dict(running=ctl.running, latched=ctl.latched, speed=round(ctl.cur), reason=ctl.reason, zone=ctl.zone, eff=round(ctl.eff()), react=ctl.react, err=motor.err),
        cfg=CFG, cpu=cpu)



