RUN={"p":None,"out":[]}
@app.post("/api/run")
def a_run():
    if RUN["p"] and RUN["p"].poll() is None: return J(False,"Something is already running")
    RUN["out"]=[]; p=RUN["p"]=subprocess.Popen([sys.executable,"-u",str(safe(request.json["path"]))],cwd=BASE,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
    threading.Thread(target=lambda:[RUN["out"].append(l) for l in p.stdout],daemon=True).start(); return J(True,"Running")
@app.post("/api/run/stop")
def a_run_stop():
    if RUN["p"] and RUN["p"].poll() is None: RUN["p"].terminate()
    return J(True)
@app.get("/api/run/out")
def a_run_out(): return jsonify(out="".join(RUN["out"][-300:]), running=bool(RUN["p"] and RUN["p"].poll() is None))

