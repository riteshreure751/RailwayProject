@app.route("/video_feed")
def video_feed():
    def gen():
        last=0
        while True:
            with cam.cond: cam.cond.wait_for(lambda: cam.t!=last, 2); last=cam.t; j=cam.jpg
            yield b"--f\r\nContent-Type: image/jpeg\r\n\r\n"+j+b"\r\n"
    return Response(gen(), mimetype="multipart/x-mixed-replace; boundary=f")
@sock.route("/ws")
def ws_tel(ws):
    ctl.clients+=1; last=0
    try:
        while True:
            m = ws.receive(timeout=.05)
            if m: ctl.hb=time.time()
            if time.time()-last>=.05: ws.send(json.dumps(snap())); last=time.time()
    except Exception: pass
    finally: ctl.clients-=1
@sock.route("/term")
def term(ws):
    if not session.get("ok"): return
    pid, fd = pty.fork()
    if pid==0: os.chdir(BASE); os.environ["TERM"]="dumb"; os.execvp("bash",["bash","-i"])
    def rd():
        try:
            while True:
                d=os.read(fd,4096)
                if not d: break
                ws.send(d.decode("utf-8","replace"))
        except Exception: pass
    threading.Thread(target=rd,daemon=True).start()
    try:
        while True:
            m=ws.receive()
            if m is None: break
            os.write(fd,m.encode())
    except Exception: pass
    finally:
        try: os.kill(pid,signal.SIGHUP); os.waitpid(pid,0)
        except Exception: pass

